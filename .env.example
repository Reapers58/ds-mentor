APP_NAME=DS-Mentor
DEBUG=true

# Hybrid (local dev) setup: data stores run in Docker (Postgres on host 5433,
# Qdrant on host 6333, Redis on host 6379) and the app runs locally.
# For a fully-Dockerized setup, replace hostnames with the compose service
# names instead (postgres:5432, qdrant:6333, redis:6379).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/dsmentor
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5433/dsmentor

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=sop_docs

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

EMBEDDING_MODEL=all-MiniLM-L6-v2

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

REDIS_URL=redis://localhost:6379/0
